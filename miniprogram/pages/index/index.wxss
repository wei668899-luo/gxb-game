.home {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 80rpx;
}

.home-header {
  text-align: center;
}

.brand-mark {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 32rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0f5132;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
  box-shadow: 0 20rpx 44rpx rgba(15, 81, 50, 0.22);
}

.home-title {
  font-size: 52rpx;
  font-weight: 700;
}

.home-subtitle {
  margin-top: 16rpx;
  color: #66756d;
  font-size: 28rpx;
}

.home-actions {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.join-panel {
  padding: 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(24, 37, 31, 0.08);
}

.room-code-input {
  height: 90rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 2rpx solid #d8ded9;
  border-radius: 14rpx;
  font-size: 38rpx;
  letter-spacing: 8rpx;
  text-align: center;
}
